<?xml version="1.0" encoding="UTF-8"?>
<!--
    gta4l (Galaxy Tab A7 10.4 LTE) - Evolution X (Android 17, branch cnb)

    Usage:
        repo init -u https://github.com/Evolution-X/manifest -b cnb
        mkdir -p .repo/local_manifests
        curl -L -o .repo/local_manifests/gta4l.xml \
          https://raw.githubusercontent.com/mkvenompro/gta4l_local_manifest/evo-a17/local_manifest.xml
        repo sync -j8

    Do not use "breakfast gta4l" - these forks are not in the
    LineageOS / Evolution-X-Devices organizations.
-->
<manifest>

  <!-- Device trees: Evolution X / Android 17 -->
  <project
      path="device/samsung/gta4l"
      name="mkvenompro/android_device_samsung_gta4l"
      remote="github"
      revision="evolution-a17" />

  <project
      path="device/samsung/gta4l-common"
      name="mkvenompro/android_device_samsung_gta4l-common"
      remote="github"
      revision="evolution-a17" />

  <!-- Kernel: LineageOS 24 (Android 17) -->
  <project
      path="kernel/samsung/sm6115"
      name="LineageOS/android_kernel_samsung_sm6115"
      remote="github"
      revision="lineage-24.0" />

  <!-- Proprietary blobs: LineageOS 24 -->
  <project
      path="vendor/samsung/gta4l"
      name="TheMuppets/proprietary_vendor_samsung_gta4l"
      remote="github"
      revision="lineage-24.0" />

  <project
      path="vendor/samsung/gta4l-common"
      name="TheMuppets/proprietary_vendor_samsung_gta4l-common"
      remote="github"
      revision="lineage-24.0" />

  <!-- Samsung hardware (not shipped by the Evolution X manifest) -->
  <project
      path="hardware/samsung"
      name="LineageOS/android_hardware_samsung"
      remote="github"
      revision="lineage-24.0" />

  <!-- Dolby Atmos (Evolution X) -->
  <project
      path="hardware/dolby"
      name="Evolution-X-Devices/hardware_dolby"
      remote="github"
      revision="cnb" />

</manifest>
